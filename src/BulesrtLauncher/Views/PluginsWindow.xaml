<Window x:Class="BulesrtLauncher.Views.PluginsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BulesrtLauncher.Services.Ui"
        Title="插件 · Bulesrt Launcher" Width="720" Height="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="插件" FontSize="17" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText" Text="正在读取…" FontSize="12" Foreground="{DynamicResource DimBrush}" Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,14,0,0" CornerRadius="12" Background="{Binding CardBrush, Source={x:Static ui:SurfaceState.Instance}}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <ItemsControl x:Name="PluginList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="9" Padding="10,8" Margin="0,0,0,6" Background="{Binding Card2Brush, Source={x:Static ui:SurfaceState.Instance}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock FontSize="13" FontWeight="SemiBold">
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                            <Run Text="{Binding VersionText, Mode=OneWay}" Foreground="{DynamicResource DimBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource DimBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center"
                                            Background="{Binding StatusBrush}">
                                        <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="White" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="把插件文件夹放进 plugins\ 后点「重新加载」；重载不会卸载已加载的插件，新插件重启后生效。"
                       FontSize="11.5" Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Style="{StaticResource GhostButton}" Content="打开插件目录" Click="OpenFolder_Click" />
                <Button Style="{StaticResource BaseButton}" Content="重新加载" Margin="8,0,0,0" Click="Reload_Click" />
                <Button Style="{StaticResource PrimaryButton}" Content="关闭" Margin="8,0,0,0" Click="Close_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
