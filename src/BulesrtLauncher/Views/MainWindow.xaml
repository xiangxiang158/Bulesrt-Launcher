<Window x:Class="BulesrtLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BulesrtLauncher.Services.Ui"
        Title="Bulesrt Launcher" Width="1200" Height="780" MinWidth="1000" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize" Background="Transparent" AllowsTransparency="True"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextBrush}" FontSize="13"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        SourceInitialized="Window_SourceInitialized" StateChanged="Window_StateChanged"
        UseLayoutRounding="True" SnapsToDevicePixels="True">


    <Border x:Name="Root" Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            CornerRadius="12" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <!-- A layered window skips hit-testing on fully transparent pixels, so at 100% glass the
                 window would become click-through and impossible to drag. This 1/255 veil is invisible
                 but keeps every pixel of the window clickable. -->
            <Rectangle Grid.RowSpan="3" Fill="#02000000" />

            <!-- ================= backdrop (custom image / built-in glow) ================= -->
            <Grid x:Name="Backdrop" Grid.RowSpan="3" ClipToBounds="True" IsHitTestVisible="False">
                <Rectangle Fill="{DynamicResource BgBrush}" />
                <Image x:Name="BgImage" Stretch="UniformToFill" Visibility="Collapsed"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <BlurEffect x:Name="BgBlurEffect" Radius="0" KernelType="Gaussian" RenderingBias="Performance" />
                    </Image.Effect>
                </Image>
                <Rectangle x:Name="BgScrim" Fill="#000000" Opacity="0" />
                <!-- keeps title bar + sidebar text readable on bright photos -->
                <Rectangle x:Name="TopScrim" Height="110" VerticalAlignment="Top" Opacity="0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle x:Name="LeftScrim" Width="320" HorizontalAlignment="Left" Opacity="0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Fill="{DynamicResource GlowBrush}" />
            </Grid>

            <!-- ================= title bar ================= -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7" Margin="14,0,10,0"
                        VerticalAlignment="Center" SnapsToDevicePixels="True">
                    <Border.Background>
                        <ImageBrush ImageSource="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Bulesrt Launcher" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Width="1" Height="14" Background="{DynamicResource LineBrush}" Margin="16,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="BreadcrumbText" Text="全部" FontSize="13" Foreground="{DynamicResource Text2Brush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="BtnSearch" Style="{StaticResource IconButton}" Content="&#xE721;" ToolTip="搜索  Ctrl+K" Click="BtnSearch_Click" />
                    <Button x:Name="BtnTheme" Style="{StaticResource IconButton}" Content="&#xE706;" ToolTip="切换主题" Click="BtnTheme_Click" />
                    <Button x:Name="BtnSettings" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="设置" Click="BtnSettings_Click" />
                    <Border Width="1" Height="18" Background="{DynamicResource LineBrush}" Margin="8,0" />
                    <Button x:Name="BtnMinWindow" Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="最小化" Click="BtnMin_Click" />
                    <Button x:Name="BtnCloseWindow" Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="关闭" Click="BtnClose_Click" />
                </StackPanel>
            </Grid>

            <!-- ================= body ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- sidebar -->
                <Border Grid.Column="0" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,1,0">
                    <DockPanel Margin="10,10,10,10">
                        <Button DockPanel.Dock="Bottom" x:Name="BtnNewCategory" Height="40" HorizontalContentAlignment="Left"
                                Style="{StaticResource GhostButton}" BorderThickness="0" Padding="11,0" Click="BtnNewCategory_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                                <TextBlock Text="新建分类" FontSize="13.5" Margin="11,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource LineSoftBrush}" Margin="0,8,0,8" />
                        <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="NavList_SelectionChanged" AllowDrop="True" PreviewMouseLeftButtonDown="NavList_PreviewMouseLeftButtonDown" PreviewMouseMove="NavList_MouseMove" PreviewMouseRightButtonUp="NavList_PreviewMouseRightButtonUp" DragOver="NavList_DragOver" DragLeave="NavList_DragLeave" Drop="NavList_Drop"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </Border>

                <!-- content -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="22,0,18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderTitle" Text="全部" Style="{StaticResource H1}" />
                            <TextBlock x:Name="HeaderCount" Text="0 个项目" Style="{StaticResource Muted}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnView" Style="{StaticResource IconButton}" Content="&#xE8FD;" ToolTip="切换视图" Click="BtnView_Click" />
                            <Button x:Name="BtnBatch" Style="{StaticResource GhostButton}" Content="批量添加" Margin="8,0,0,0" Click="BtnBatch_Click" />
                            <Button x:Name="BtnAdd" Style="{StaticResource AccentIconButton}" Content="&#xE710;" Margin="8,0,0,0" ToolTip="添加项目" Click="BtnAdd_Click" />
                        </StackPanel>
                    </Grid>

                    <ContentControl x:Name="PluginPageArea" Grid.Row="1" Visibility="Collapsed"
                                    Margin="14,0,10,10" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,6,16" x:Name="ContentScroll">
                        <Grid Margin="14,0,10,0" Background="Transparent"
                              MouseLeftButtonDown="ContentArea_MouseLeftButtonDown"
                              MouseRightButtonUp="ContentArea_MouseRightButtonUp">
                            <StackPanel x:Name="EmptyHint" Visibility="Collapsed" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Margin="0,120,0,0">
                                <TextBlock Text="这里还没有项目" FontSize="15" Foreground="{DynamicResource Text2Brush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="点右上角 + 添加，或把快捷方式拖进窗口" FontSize="12.5"
                                           Foreground="{DynamicResource DimBrush}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                                <Button Content="添加第一个项目" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                                        HorizontalAlignment="Center" Click="BtnAdd_Click" />
                            </StackPanel>
                            <ItemsControl x:Name="GridItems" Visibility="Visible">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="tile" Width="104" Padding="4,8,4,9" CornerRadius="12" Background="Transparent"
                                                BorderBrush="Transparent" BorderThickness="1"
                                                MouseLeftButtonDown="Tile_MouseLeftButtonDown" MouseMove="Tile_MouseMove" MouseRightButtonUp="Tile_MouseRightButtonUp">
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <StackPanel MaxWidth="420">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock Text="{Binding Target}" FontSize="11.5" Margin="0,4,0,0"
                                                                   Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="argsLine" Text="{Binding Arguments, StringFormat=参数：{0}}"
                                                                   FontSize="11.5" Margin="0,4,0,0" Foreground="{DynamicResource DimBrush}"
                                                                   Visibility="Collapsed" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <StackPanel>
                                                <Border Width="84" Height="84" CornerRadius="18" Background="{Binding TileBrush, Source={x:Static ui:SurfaceState.Instance}}"
                                                        HorizontalAlignment="Center">
                                                    <Grid>
                                                        <Border Margin="10" CornerRadius="12"
                                                                Background="{Binding Name, Converter={StaticResource LetterBrush}}"
                                                                Opacity="{Binding TileFade, Source={x:Static ui:SurfaceState.Instance}}"
                                                                Visibility="{Binding Icon, Converter={StaticResource NullToVis}}">
                                                            <TextBlock Text="{Binding Letter}" FontSize="25" FontWeight="Bold"
                                                                       Foreground="#F4FFFC"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Image Source="{Binding Icon}" Width="64" Height="64" Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                        <Ellipse Width="11" Height="11" Fill="#3FD08E"
                                                                 Stroke="{DynamicResource BgBrush}" StrokeThickness="2"
                                                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
                                                                 ToolTip="运行中"
                                                                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" Margin="0,9,0,0"
                                                           HorizontalAlignment="Center" MaxWidth="96" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="tile" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tile" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="tile" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Arguments}" Value="">
                                                <Setter TargetName="argsLine" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Arguments}" Value="{x:Null}">
                                                <Setter TargetName="argsLine" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl x:Name="ListItems" Visibility="Collapsed">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="row" Height="54" CornerRadius="10" Background="Transparent" Padding="12,0"
                                                BorderBrush="Transparent" BorderThickness="1"
                                                MouseLeftButtonDown="Tile_MouseLeftButtonDown" MouseMove="Tile_MouseMove" MouseRightButtonUp="Tile_MouseRightButtonUp"
                                                ToolTip="{Binding Target}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                                                        Background="{Binding Card2Brush, Source={x:Static ui:SurfaceState.Instance}}" VerticalAlignment="Center">
                                                    <Grid>
                                                        <Border Margin="4" CornerRadius="6"
                                                                Background="{Binding Name, Converter={StaticResource LetterBrush}}"
                                                                Opacity="{Binding TileFade, Source={x:Static ui:SurfaceState.Instance}}"
                                                                Visibility="{Binding Icon, Converter={StaticResource NullToVis}}">
                                                            <TextBlock Text="{Binding Letter}" FontSize="13" FontWeight="Bold"
                                                                       Foreground="#F4FFFC"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Image Source="{Binding Icon}" Width="26" Height="26"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Target}" FontSize="11.5" Foreground="{DynamicResource DimBrush}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" Fill="#3FD08E" Margin="0,0,7,0"
                                                             VerticalAlignment="Center"
                                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock VerticalAlignment="Center" FontSize="12"
                                                               Foreground="{DynamicResource DimBrush}" Text="{Binding StatusText}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="row" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ================= toasts ================= -->
            <StackPanel x:Name="ToastHost" Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,18,54" IsHitTestVisible="False" />

            <!-- ================= status bar ================= -->
            <Grid Grid.Row="2" Background="Transparent">
                <Border BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0" />
                <Grid Margin="18,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="已就绪" FontSize="12" Foreground="{DynamicResource DimBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="HotkeyHint" Text="Ctrl+Alt+Space 唤起" FontSize="12"
                                   Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Border Background="{Binding CardBrush, Source={x:Static ui:SurfaceState.Instance}}" CornerRadius="9" Padding="2" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ViewGridChip" Style="{StaticResource SegChip}" Content="图标" IsChecked="True"
                                             Padding="12,4" BorderThickness="0" GroupName="view" Checked="ViewChip_Checked" />
                                <RadioButton x:Name="ViewListChip" Style="{StaticResource SegChip}" Content="列表"
                                             Padding="12,4" BorderThickness="0" GroupName="view" Checked="ViewChip_Checked" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ================= search overlay ================= -->
            <Grid x:Name="SearchLayer" Grid.RowSpan="3" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed"
                  MouseLeftButtonDown="SearchLayer_MouseDown">
                <Border Width="880" MaxHeight="560" VerticalAlignment="Top" Margin="0,72,0,0" CornerRadius="16"
                        Background="{DynamicResource DialogBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="18,14,18,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                       Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" Margin="12,0,0,0" Background="Transparent" BorderThickness="0"
                                     FontSize="17" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                     VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_KeyDown" />
                            <Border Grid.Column="2" Background="{Binding Card2Brush, Source={x:Static ui:SurfaceState.Instance}}" CornerRadius="6" Padding="7,2"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                <TextBlock Text="Esc" FontSize="11" Foreground="{DynamicResource Text2Brush}" />
                            </Border>
                        </Grid>
                        <Border Grid.Row="0" Height="1" Background="{DynamicResource LineSoftBrush}" VerticalAlignment="Bottom" />
                        <ListBox x:Name="SearchList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="8,8,8,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="SearchList_DoubleClick" PreviewKeyDown="SearchList_KeyDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" CornerRadius="10" Padding="10,9" Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{Binding Card2Brush, Source={x:Static ui:SurfaceState.Instance}}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="{Binding CardBrush, Source={x:Static ui:SurfaceState.Instance}}">
                                            <Grid>
                                                <Border Margin="4" CornerRadius="6"
                                                        Background="{Binding Item.Name, Converter={StaticResource LetterBrush}}"
                                                        Visibility="{Binding Item.Icon, Converter={StaticResource NullToVis}}">
                                                    <TextBlock Text="{Binding Item.Letter}" FontSize="13" FontWeight="Bold"
                                                               Foreground="#F4FFFC"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Image Source="{Binding Item.Icon}" Width="26" Height="26" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Item.Name}" FontSize="14" />
                                            <TextBlock Text="{Binding Item.Target}" FontSize="11.5" Foreground="{DynamicResource DimBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{Binding Card2Brush, Source={x:Static ui:SurfaceState.Instance}}" CornerRadius="6" Padding="8,2">
                                                <TextBlock Text="{Binding CategoryName}" FontSize="11.5" Foreground="{DynamicResource Text2Brush}" />
                                            </Border>
                                            <Border Background="{Binding Card2Brush, Source={x:Static ui:SurfaceState.Instance}}" CornerRadius="6" Padding="8,2" Margin="8,0,0,0">
                                                <TextBlock Text="Enter" FontSize="11.5" Foreground="{DynamicResource TextBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="18,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↑ ↓ 选择" FontSize="12" Foreground="{DynamicResource DimBrush}" />
                                <TextBlock Text="Enter 运行" FontSize="12" Foreground="{DynamicResource DimBrush}" Margin="18,0,0,0" />
                                <TextBlock Text="Esc 关闭" FontSize="12" Foreground="{DynamicResource DimBrush}" Margin="18,0,0,0" />
                                <TextBlock Text="Ctrl+K 搜索" FontSize="12" Foreground="{DynamicResource DimBrush}" Margin="18,0,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= modal layer ================= -->
            <Grid x:Name="ModalLayer" Grid.RowSpan="3" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed"
                  MouseLeftButtonDown="ModalLayer_MouseDown">
                <Border x:Name="ModalCard" Width="900" HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="14" Background="{DynamicResource DialogBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <Grid>
                        <Grid x:Name="PanelSettings" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="20,16,12,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="偏好设置 · 背景改动即时预览" FontSize="12.5" Foreground="{DynamicResource DimBrush}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="CloseModal_Click" />
                            </Grid>
                            <Border Grid.Row="0" Height="1" Background="{DynamicResource LineSoftBrush}" VerticalAlignment="Bottom" />
                            <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto">
                                <Grid Margin="20,16,20,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="常规" Style="{StaticResource SectionTitle}" />
                                        <CheckBox x:Name="SetAutostart" Style="{StaticResource CheckBoxDark}" Content="开机自启动" Margin="0,4" />
                                        <CheckBox x:Name="SetHide" Style="{StaticResource CheckBoxDark}" Content="启动项目后隐藏窗口" Margin="0,4" />
                                        <CheckBox x:Name="SetSoftware" Style="{StaticResource CheckBoxDark}" Content="兼容模式（软件渲染，重启生效）" Margin="0,4"
                                                  ToolTip="显卡驱动或远程桌面环境下启动黑屏时勾选" />
                                        <CheckBox x:Name="SetShowRunning" Style="{StaticResource CheckBoxDark}" Content="显示运行状态" Margin="0,4"
                                                  ToolTip="每 3 秒扫一次进程，运行中的项目右上角亮绿点"
                                                  Checked="SetShowRunning_Changed" Unchecked="SetShowRunning_Changed" />
                                        <TextBlock Text="关闭按钮" FontSize="13" Margin="0,10,0,8" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="CloseAsk" Style="{StaticResource Chip}" Content="每次询问" GroupName="close" Margin="0,0,8,0" />
                                            <RadioButton x:Name="CloseMin" Style="{StaticResource Chip}" Content="最小化到托盘" GroupName="close" Margin="0,0,8,0" />
                                            <RadioButton x:Name="CloseExit" Style="{StaticResource Chip}" Content="直接退出" GroupName="close" />
                                        </StackPanel>
                                        <TextBlock Text="快捷键" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
                                        <TextBlock Text="主热键" FontSize="13" Margin="0,0,0,8" />
                                        <TextBox x:Name="SetHotkey" Style="{StaticResource InputBox}" IsReadOnly="True" Cursor="Hand"
                                                 PreviewKeyDown="SetHotkey_PreviewKeyDown" GotFocus="SetHotkey_GotFocus" />
                                        <TextBlock Text="点击输入框后按组合键，Backspace 清除。" FontSize="11.5" Foreground="{DynamicResource DimBrush}"
                                                   Margin="0,7,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="背景" Style="{StaticResource SectionTitle}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource BaseButton}" Height="30" Content="选择图片…"
                                                    Click="PickBackground_Click" />
                                            <Button Style="{StaticResource GhostButton}" Height="30" Content="清除" Margin="8,0,0,0"
                                                    Click="ClearBackground_Click" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Style="{StaticResource GhostButton}" Height="28" Content="插画背景"
                                                    Click="UseArtwork_Click" />
                                            <Button Style="{StaticResource GhostButton}" Height="28" Content="插画 + 透明盒子"
                                                    Margin="8,0,0,0" Click="PresetGlass_Click"
                                                    ToolTip="插画做背景、压暗 30%、图标盒子 100% 透明、深色主题 —— 和文档截图一模一样" />
                                        </StackPanel>
                                        <TextBlock x:Name="BgName" Text="未设置 · 使用内置深蓝背景" FontSize="11.5"
                                                   Foreground="{DynamicResource DimBrush}" Margin="0,8,0,0"
                                                   TextTrimming="CharacterEllipsis" />

                                        <Grid Margin="0,12,0,0">
                                            <TextBlock Text="模糊" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" />
                                            <TextBlock x:Name="BgBlurVal" Text="0" FontSize="12.5" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource DimBrush}" />
                                        </Grid>
                                        <Slider x:Name="SetBgBlur" Style="{StaticResource SliderDark}" Minimum="0" Maximum="60"
                                                SmallChange="1" LargeChange="8" ValueChanged="BgBlur_Changed" />

                                        <Grid Margin="0,8,0,0">
                                            <TextBlock Text="压暗" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" />
                                            <TextBlock x:Name="BgDimVal" Text="0%" FontSize="12.5" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource DimBrush}" />
                                        </Grid>
                                        <Slider x:Name="SetBgDim" Style="{StaticResource SliderDark}" Minimum="0" Maximum="85"
                                                SmallChange="1" LargeChange="8" ValueChanged="BgDim_Changed" />

                                        <Grid Margin="0,8,0,0">
                                            <TextBlock Text="图标盒子透明" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" />
                                            <TextBlock x:Name="SurfaceVal" Text="0%" FontSize="12.5" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource DimBrush}" />
                                        </Grid>
                                        <Slider x:Name="SetSurface" Style="{StaticResource SliderDark}" Minimum="0" Maximum="100"
                                                SmallChange="1" LargeChange="8" ValueChanged="Surface_Changed" />

                                        <Grid Margin="0,8,0,0">
                                            <TextBlock Text="主页背景透明" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" />
                                            <TextBlock x:Name="WindowTransVal" Text="0%" FontSize="12.5" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource DimBrush}" />
                                        </Grid>
                                        <Slider x:Name="SetWindowTrans" Style="{StaticResource SliderDark}" Minimum="0" Maximum="100"
                                                SmallChange="1" LargeChange="5" ValueChanged="WindowTrans_Changed" />
                                        <CheckBox x:Name="SetAnimation" Style="{StaticResource CheckBoxDark}"
                                                  Content="播放动图（GIF）" Margin="0,8,0,0" Checked="SetAnimation_Changed"
                                                  Unchecked="SetAnimation_Changed" />
                                        <TextBlock Text="盒子透明 = 图标底下那层方块；主页背景透明 = 整个页面淡出、露出桌面。"
                                                   FontSize="11" Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="外观" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="主题" FontSize="13" Margin="0,10,0,8" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ThemeDark" Style="{StaticResource Chip}" Content="深蓝 · 深色" GroupName="theme" Margin="0,0,8,0" />
                                            <RadioButton x:Name="ThemeLight" Style="{StaticResource Chip}" Content="深蓝 · 浅色" GroupName="theme" />
                                        </StackPanel>
                                        <TextBlock Text="默认视图" FontSize="13" Margin="0,10,0,8" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ViewGrid" Style="{StaticResource Chip}" Content="图标" GroupName="defview" Margin="0,0,8,0" />
                                            <RadioButton x:Name="ViewList" Style="{StaticResource Chip}" Content="列表" GroupName="defview" />
                                        </StackPanel>
                                        <TextBlock Text="界面缩放" FontSize="13" Margin="0,10,0,8" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="Scale100" Style="{StaticResource Chip}" Content="100%" GroupName="scale" Margin="0,0,8,0" />
                                            <RadioButton x:Name="Scale110" Style="{StaticResource Chip}" Content="110%" GroupName="scale" Margin="0,0,8,0" />
                                            <RadioButton x:Name="Scale125" Style="{StaticResource Chip}" Content="125%" GroupName="scale" />
                                        </StackPanel>
                                        <TextBlock Text="数据" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
                                        <TextBlock Text="数据目录" FontSize="13" Margin="0,0,0,8" />
                                        <TextBox x:Name="SetDataDir" Style="{StaticResource InputBox}" IsReadOnly="True" />
                                        <TextBlock x:Name="SetDataDirLink" Text="打开数据目录" FontSize="12.5" Foreground="{DynamicResource AccentBrush}"
                                                   Margin="0,10,0,0" Cursor="Hand" MouseLeftButtonUp="SetDataDirLink_Click" />
                                        <TextBlock Text="重扫快捷方式" FontSize="12.5" Foreground="{DynamicResource AccentBrush}"
                                                   Margin="0,8,0,0" Cursor="Hand" MouseLeftButtonUp="Reseed_Click" />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                            <Border Grid.Row="2" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 左下角：插件 + 关于 -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="插件" FontSize="11.5" Width="34" Foreground="{DynamicResource DimBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="PluginManagerLink" Text="插件管理…" FontSize="12"
                                                       Foreground="{DynamicResource AccentBrush}" Cursor="Hand" Background="Transparent"
                                                       MouseLeftButtonUp="PluginsPanel_Click" />
                                            <TextBlock x:Name="PluginCommandsLink" Text="插件命令…" FontSize="12"
                                                       Foreground="{DynamicResource AccentBrush}" Margin="12,0,0,0"
                                                       Cursor="Hand" Background="Transparent"
                                                       MouseLeftButtonUp="PluginCommands_Click" />
                                            <TextBlock Text="打开插件目录" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                                       Margin="12,0,0,0" Cursor="Hand" Background="Transparent"
                                                       MouseLeftButtonUp="PluginFolder_Click" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="关于" FontSize="11.5" Width="34" Foreground="{DynamicResource DimBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="AboutProduct" Text="Bulesrt Launcher" FontSize="11.5"
                                                       Foreground="{DynamicResource Text2Brush}" />
                                            <TextBlock x:Name="AboutVersion" Text="版本 2.0.0" FontSize="11.5"
                                                       Foreground="{DynamicResource DimBrush}" Margin="8,0,0,0" />
                                            <TextBlock x:Name="AboutCopyright" Text="© 2026 xiang · 保留所有权利" FontSize="11.5"
                                                       Foreground="{DynamicResource DimBrush}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 右下角：提示 + 按钮 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="更改将在点击应用或确定后生效" FontSize="11.5"
                                                   Foreground="{DynamicResource DimBrush}" HorizontalAlignment="Right"
                                                   Margin="0,0,0,6" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="UninstallButton" Style="{StaticResource GhostButton}" Content="卸载…"
                                                    Foreground="{DynamicResource DangerBrush}" Margin="0,0,10,0"
                                                    ToolTip="卸载 Bulesrt Launcher：会关闭启动器并删除程序文件，data\ 里的项目库默认保留"
                                                    Click="UninstallButton_Click" />
                                            <Button Style="{StaticResource GhostButton}" Content="取消" Click="CloseModal_Click" />
                                            <Button Style="{StaticResource BaseButton}" Content="应用" Margin="10,0,0,0" Click="SettingsApply_Click" />
                                            <Button Style="{StaticResource PrimaryButton}" Content="确定" Margin="10,0,0,0" Click="SettingsOk_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="PanelEditor" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="20,16,12,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="EditorTitle" Text="添加项目" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="支持 exe / lnk / url / 文件夹 / 任意文件" FontSize="12.5"
                                               Foreground="{DynamicResource DimBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="CloseModal_Click" />
                            </Grid>
                            <Border Grid.Row="0" Height="1" Background="{DynamicResource LineSoftBrush}" VerticalAlignment="Bottom" />
                            <StackPanel Grid.Row="1" Margin="20,16,20,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="名称" FontSize="13" Margin="0,0,0,8" />
                                        <TextBox x:Name="EdName" Style="{StaticResource InputBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="分类" FontSize="13" Margin="0,0,0,8" />
                                        <WrapPanel x:Name="EdCategories" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="目标路径" FontSize="13" Margin="0,16,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="EdPath" Style="{StaticResource InputBox}" />
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="浏览…" Margin="8,0,0,0" Click="EdBrowse_Click" />
                                </Grid>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="启动参数" FontSize="13" Margin="0,0,0,8" />
                                        <TextBox x:Name="EdArgs" Style="{StaticResource InputBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="工作目录" FontSize="13" Margin="0,0,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="EdWorkDir" Style="{StaticResource InputBox}" />
                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="…" Margin="8,0,0,0" Click="EdBrowseDir_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="留空时自动推断工作目录（含米哈游启动器等特殊目录结构）。" FontSize="11.5"
                                           Foreground="{DynamicResource DimBrush}" Margin="0,10,0,0" />
                            </StackPanel>
                            <Border Grid.Row="2" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                                <Grid>
                                    <TextBlock Text="保存后会尝试提取系统图标" FontSize="11.5" Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource GhostButton}" Content="取消" Click="CloseModal_Click" />
                                        <Button x:Name="EdSave" Style="{StaticResource PrimaryButton}" Content="保存" Margin="10,0,0,0" Click="EdSave_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="PanelBatch" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="20,16,12,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="批量添加" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="每行一个路径，或点「浏览文件」多选" FontSize="12.5" Foreground="{DynamicResource DimBrush}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="CloseModal_Click" />
                            </Grid>
                            <Border Grid.Row="0" Height="1" Background="{DynamicResource LineSoftBrush}" VerticalAlignment="Bottom" />
                            <StackPanel Grid.Row="1" Margin="20,16,20,10">
                                <TextBox x:Name="BatchText" Style="{StaticResource InputBox}" Height="220" AcceptsReturn="True"
                                         TextWrapping="NoWrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                         Padding="11,9" VerticalAlignment="Stretch" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="浏览文件…" FontSize="12.5" Foreground="{DynamicResource AccentBrush}" Cursor="Hand"
                                               MouseLeftButtonUp="BatchBrowse_Click" />
                                    <TextBlock Text="导入桌面 / 开始菜单" FontSize="12.5" Foreground="{DynamicResource AccentBrush}"
                                               Margin="18,0,0,0" Cursor="Hand" MouseLeftButtonUp="Reseed_Click" />
                                </StackPanel>
                                <TextBlock Text="导入到分类" FontSize="13" Margin="0,16,0,8" />
                                <WrapPanel x:Name="BatchCategories" />
                            </StackPanel>
                            <Border Grid.Row="2" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource GhostButton}" Content="取消" Click="CloseModal_Click" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="添加" Margin="10,0,0,0" Click="BatchOk_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel x:Name="PanelConfirm" Visibility="Collapsed" Margin="24,22,24,20">
                            <TextBlock x:Name="ConfirmTitle" Text="确认" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="ConfirmText" FontSize="13" Foreground="{DynamicResource Text2Brush}"
                                       TextWrapping="Wrap" Margin="0,14,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="取消" Click="CloseModal_Click" />
                                <Button x:Name="ConfirmOk" Style="{StaticResource DangerButton}" Content="确定" Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="PanelUninstall" Visibility="Collapsed" Margin="24,22,24,20">
                            <TextBlock Text="卸载 Bulesrt Launcher" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="会先退出启动器，再删掉程序文件、桌面与开始菜单快捷方式、开机自启，以及「应用和功能」里的条目。"
                                       FontSize="13" Foreground="{DynamicResource Text2Brush}"
                                       TextWrapping="Wrap" Margin="0,12,0,0" />
                            <TextBlock Text="安装目录" FontSize="12.5" Foreground="{DynamicResource DimBrush}" Margin="0,14,0,6" />
                            <Border Background="{Binding CardBrush, Source={x:Static ui:SurfaceState.Instance}}" CornerRadius="8" Padding="12,9"
                                    BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1">
                                <TextBlock x:Name="UninstallDirText" FontSize="12" Foreground="{DynamicResource Text2Brush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                            <CheckBox x:Name="UninstallRemoveData" Style="{StaticResource CheckBoxDark}"
                                      Content="同时删除 data\（项目库、图标缓存、背景图 —— 删了找不回来）" Margin="0,14,0,0" />
                            <TextBlock Text="不勾选时项目库留在原地，以后装回来还能接着用。"
                                       FontSize="11.5" Foreground="{DynamicResource DimBrush}"
                                       TextWrapping="Wrap" Margin="0,10,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="取消" Click="CloseModal_Click" />
                                <Button Style="{StaticResource DangerButton}" Content="卸载" Margin="10,0,0,0"
                                        Click="UninstallConfirm_Click" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="PanelCloseAsk" Visibility="Collapsed" Margin="24,22,24,20">
                            <TextBlock Text="关闭窗口" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="要最小化到托盘继续待命，还是直接退出程序？"
                                       FontSize="13" Foreground="{DynamicResource Text2Brush}"
                                       TextWrapping="Wrap" Margin="0,12,0,0" />
                            <CheckBox x:Name="CloseRemember" Style="{StaticResource CheckBoxDark}"
                                      Content="记住我的选择（之后可在设置里修改）" Margin="0,16,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="取消" Click="CloseAskCancel_Click" />
                                <Button Style="{StaticResource BaseButton}" Content="最小化到托盘" Margin="10,0,0,0"
                                        Click="CloseAskTray_Click" />
                                <Button Style="{StaticResource DangerButton}" Content="直接退出" Margin="10,0,0,0"
                                        Click="CloseAskExit_Click" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="PanelConflict" Visibility="Collapsed" Margin="24,22,24,20">
                            <TextBlock Text="发现重复项目" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="ConflictText" FontSize="13" Foreground="{DynamicResource Text2Brush}"
                                       TextWrapping="Wrap" Margin="0,12,0,0" />
                            <Border Background="{Binding CardBrush, Source={x:Static ui:SurfaceState.Instance}}" CornerRadius="10" Margin="0,14,0,0"
                                    BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" MaxHeight="230">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ConflictList" Margin="12,8,12,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Target}" FontSize="11.5" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource DimBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="取消" Click="ConflictCancel_Click" />
                                <Button Style="{StaticResource BaseButton}" Content="跳过重复项" Margin="10,0,0,0"
                                        Click="ConflictSkip_Click" />
                                <Button Style="{StaticResource PrimaryButton}" Content="覆盖已有项" Margin="10,0,0,0"
                                        Click="ConflictOverwrite_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>












