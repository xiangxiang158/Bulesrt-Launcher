<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgBrush" Color="#F3F5FD" />
    <RadialGradientBrush x:Key="GlowBrush" GradientOrigin="0.5,0.02" Center="0.5,0.02" RadiusX="0.95" RadiusY="1">
        <GradientStop Color="#2E3D5BD9" Offset="0" />
        <GradientStop Color="#0C3D5BD9" Offset="0.5" />
        <GradientStop Color="#003D5BD9" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DialogBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Card2Brush" Color="#EBEFFA" />
    <SolidColorBrush x:Key="LineBrush" Color="#D9E0F2" />
    <SolidColorBrush x:Key="LineSoftBrush" Color="#12000000" />
    <SolidColorBrush x:Key="TextBrush" Color="#141A2C" />
    <SolidColorBrush x:Key="Text2Brush" Color="#515F7C" />
    <SolidColorBrush x:Key="DimBrush" Color="#8892AC" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3D5BD9" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#223D5BD9" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D6455A" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#22D6455A" />
    <SolidColorBrush x:Key="WhiteButtonBrush" Color="#16203A" />
    <SolidColorBrush x:Key="WhiteButtonTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#99040A16" />
    <SolidColorBrush x:Key="TileBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TileHoverBrush" Color="#F0F3FD" />
    <SolidColorBrush x:Key="NavActiveBrush" Color="#1F3D5BD9" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#08000000" />
    <SolidColorBrush x:Key="InputBrush" Color="#EBEFFA" />
</ResourceDictionary>
