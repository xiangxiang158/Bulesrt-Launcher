<Window x:Class="BulesrtSetup.InstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装 Bulesrt Launcher" Width="620" Height="430" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="Transparent" AllowsTransparency="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" Foreground="{StaticResource Text}">
    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14">
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="9">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="安装 Bulesrt Launcher" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="HeaderHint" Text="下载最新版本并安装到本机" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource IconBtn}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Click="Close_Click" />
            </Grid>

            <!-- body -->
            <StackPanel Grid.Row="1" Margin="0,22,0,0">
                <TextBlock Text="安装位置" FontSize="13" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DirBox" Style="{StaticResource Input}" />
                    <Button Grid.Column="1" Style="{StaticResource Btn}" Content="浏览…" Margin="8,0,0,0" Click="Browse_Click" />
                    <Button Grid.Column="2" Style="{StaticResource Btn}" Content="默认位置" Margin="8,0,0,0" Click="DefaultDir_Click" />
                </Grid>
                <TextBlock Text="默认 %LOCALAPPDATA%\Programs\BulesrtLauncher；已有的 data 目录会被保留。" FontSize="11.5"
                           Foreground="{StaticResource Dim}" Margin="0,6,0,0" />

                <StackPanel x:Name="UrlSection">
                    <TextBlock Text="安装包地址" FontSize="13" Margin="0,18,0,8" />
                    <TextBox x:Name="UrlBox" Style="{StaticResource Input}" />
                    <TextBlock Text="支持 http(s) 链接或本地 zip 路径；也可以把 setup.json（{&quot;url&quot;:&quot;…&quot;}）放在本程序同目录。"
                               FontSize="11.5" Foreground="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border x:Name="OfflineSection" Visibility="Collapsed" Margin="0,18,0,0" Padding="12,10"
                        CornerRadius="10" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="OfflineTitle" Text="离线安装包 · 无需联网" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock x:Name="OfflineHint" Text="安装包已内置在本程序里；装完是一个空启动器（0 个项目，7 个默认分类 + 「全部」）。"
                                   FontSize="11.5" Foreground="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <CheckBox x:Name="FreshBox" Margin="0,16,0,0" Foreground="{StaticResource Text}"
                          Content="全新安装：清空现有项目（旧的 data 会先备份成 data.bak-时间）"
                          ToolTip="勾上后，安装前会把目标目录里的 data 整个改名备份，再放一份空项目库；不勾则保留你现有的项目和设置。" />
                <TextBlock x:Name="FreshHint" FontSize="11.5" Foreground="{StaticResource Danger}" Margin="0,6,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"
                           Text="⚠ 这个包默认全新安装：装完项目库是空的，你的旧数据会留在 data.bak-时间 文件夹里。" />

                <!-- 卸载模式 -->
                <Border x:Name="UninstallSection" Visibility="Collapsed" Margin="0,18,0,0" Padding="12,10"
                        CornerRadius="10" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="UninstallTitle" Text="卸载 Bulesrt Launcher" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock x:Name="UninstallHint" Text="会删掉程序文件、开始菜单和桌面快捷方式、开机自启，以及「应用和功能」里的条目。"
                                   FontSize="11.5" Foreground="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <CheckBox x:Name="RemoveDataBox" Margin="0,10,0,0" Foreground="{StaticResource Text}"
                                  Content="同时删除 data\ 和 plugins\（项目库、背景图、图标缓存、装过的插件）"
                                  ToolTip="不勾就只删程序，你的项目库会原样留在安装目录里，以后重装能直接用。" />
                        <TextBlock x:Name="RemoveDataHint" FontSize="11.5" Foreground="{StaticResource Dim}" Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="不勾选的话，卸载后安装目录里只会剩下 data\ 和 plugins\，想彻底清掉可以手动删。" />
                    </StackPanel>
                </Border>

                <ProgressBar x:Name="Bar" Height="4" Margin="0,22,0,0" Minimum="0" Maximum="100"
                             Foreground="{StaticResource Accent}" Background="{StaticResource Card}" BorderThickness="0" />
                <TextBlock x:Name="StatusText" Text="准备就绪" FontSize="12.5" Foreground="{StaticResource Text2}" Margin="0,10,0,0" />
            </StackPanel>

            <!-- footer -->
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VersionText" Text="" FontSize="11.5" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="UninstallLink" Style="{StaticResource Btn}" Content="卸载…" Margin="0,0,10,0"
                            Foreground="{StaticResource Danger}" Visibility="Collapsed"
                            ToolTip="卸载已安装的 Bulesrt Launcher"
                            Click="UninstallLink_Click" />
                    <Button x:Name="CancelButton" Style="{StaticResource Btn}" Content="取消" Click="Close_Click" />
                    <Button x:Name="InstallButton" Style="{StaticResource Primary}" Content="开始安装" Margin="10,0,0,0"
                            Click="Install_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

